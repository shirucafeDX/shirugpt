# このファイルを .env にコピーして値を埋めてください。
#   cp .env.example .env
# .env は .gitignore 済みです。鍵の中身をこのファイルに書かないでください。

# ---- 認証 --------------------------------------------------------
# 方式A（推奨）: ADC を使う。下の GOOGLE_APPLICATION_CREDENTIALS は空のままにする。
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <プロジェクトID>
#
# 方式B: サービスアカウントキーのJSONファイルを使う。
#   鍵ファイルへのパスだけをここに書く（鍵の中身は書かない）。
#   credentials/ ディレクトリは .gitignore 済み。
#   相対パスはこのリポジトリのルートからの相対として解決されます。
GOOGLE_APPLICATION_CREDENTIALS=

# ---- GCP / BigQuery ----------------------------------------------
# 対象の GCP プロジェクト ID
GCP_PROJECT_ID=fair-solution-453613-e2

# BigQuery のロケーション。データセットの場所に合わせる（例: US, asia-northeast1）
# 空にすると自動判定に任せます
BQ_LOCATION=

# アプリが既定で見に行くデータセット
BQ_DEFAULT_DATASET=202506

# アクセスを許可するデータセットのallowlist（カンマ区切り）
# ここに書かれていないデータセットへのクエリはアプリ側で拒否されます
BQ_ALLOWED_DATASETS=202506

# ---- Gemini（Agent Platform / 旧 Vertex AI）----------------------
# 有効化する API は aiplatform.googleapis.com（コンソール表示名は Agent Platform API）
# Gemini 3.8 Flashはglobal / us / euに対応
VERTEX_LOCATION=global

# 使用するモデル
GEMINI_MODEL=gemini-3.8-flash

# 旧Gemini 2.5用の思考予算。3.8では使わず、通常MEDIUMで使用する。
# /effortでLow / Medium / Highを選択。/thinkingは詳細分析を切り替える。
GEMINI_THINKING_BUDGET=

# ---- クエリのコスト・安全弁 --------------------------------------
# dry run の推定スキャン量がこれを超えたら実行前にユーザー確認を求める（バイト）
# 既定 1GB
DRY_RUN_CONFIRM_BYTES=1073741824

# BigQuery に渡す maximum_bytes_billed のハードリミット（バイト）
# これを超えるクエリはBigQuery側で実行自体が失敗する。既定 10GB
MAX_BYTES_BILLED=10737418240

# 外側に LIMIT が無いクエリへ自動付与する行数
DEFAULT_ROW_LIMIT=1000

# UI に読み込む最大行数（メモリ保護）
MAX_RESULT_ROWS=5000

# 旧形式の履歴保存用サンプル上限（モデルへの直接返却はMAX_DIRECT_ROWS）
SAMPLE_ROWS=500

# 1 ターンあたりの tool 呼び出しループ上限（暴走防止）
MAX_TOOL_ITERATIONS=50

# ---- 利用ログ（Gemini 境界の外）----------------------------------
# 利用者ごとのトークン量・クエリ量を記録する BigQuery データセット。
# 空にすると記録機能はオフ（アプリは通常どおり動作する）。
#
# ★重要: ここに書いた名前を BQ_ALLOWED_DATASETS に絶対に含めないこと。
#   含めると全利用者の使用量が Gemini から参照可能になり、
#   自然言語の質問経由で他人の利用状況が漏れる。
#   混入していた場合はアプリが起動時に ConfigError で停止する。
BQ_LOG_DATASET=

# ログテーブル名（既定 usage_events）
BQ_LOG_TABLE=usage_events

# 月次の使用制限（利用者ごとの月間USD上限）を保存するテーブル名。
# BQ_LOG_DATASET と同じデータセット内に置くので、Gemini 境界の防御は
# そのまま適用される（別途 allowlist に気をつける必要はない）。
BQ_LIMIT_TABLE=user_limits

# 管理者ページ（利用状況）を開けるメールアドレス（カンマ区切り）。
# Streamlit Community Cloud でログイン中の閲覧者メールと照合する。
# 大文字小文字は区別しない。
ADMIN_EMAILS=

# ローカル開発時のみ、閲覧者メールが取れなくても管理者ページを開く。
# ★Streamlit Cloud の Secrets には絶対に設定しないこと（認証を迂回する）。
ADMIN_ALLOW_LOCAL=

# 会話履歴。空なら無効。ログインした本人の履歴のみ保存・復元する。
CHAT_HISTORY_BUCKET=shirugpt-history

# Analysis Layer: 表全体をLLMへ送らず、必要な分析結果だけ返す
MAX_DIRECT_ROWS=100
MAX_PREVIEW_ROWS=50
MEDIUM_RESULT_ROWS=1000
# 推定トークン数（モデル実測値ではない）
MAX_DATA_TOKENS=8000
TARGET_DATA_TOKENS=4000
MAX_HISTORY_TOKENS=16000
ANALYSIS_TIMEOUT_SECONDS=3
BQ_QUERY_TIMEOUT_SECONDS=120
